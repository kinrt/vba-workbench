{
  "defaults": {
    "common_dir": "src/common",
    "backup_dir": ".backup",
    "import_document_modules": false,
    "backup_auto_clean": true,
    "backup_keep": 10,
    "backup_keep_daily": 0,
    "backup_min_keep": 3,
    "backup_protect": ["-覆盖前"],
    "assert_macro": "测试表格工具.运行全部断言",
    "assert_sheet": "测试表",
    "require_version": true
  },
  "projects": [
    {
      "name": "示例表A",
      "search_dir": "C:/Users/<用户>/表格/示例表A",
      "prefix": "示例表A",
      "require_version": true,
      "src": "src/projects/示例表A",
      "common_version": "1.3.0",
      "common_modules": "auto",
      "note": "文件名必须是「示例表A V<数字>.xlsm」；prefix 只写基名，版本号靠文件名自动取最大"
    }
  ]
}
